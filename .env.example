# Payments stay off unless this is exactly "true".
# Even then, checkout refuses any key that is not a Stripe test key,
# and it does not create a charge yet.
ENABLE_STRIPE=false

# Test key only. Never put a live secret (sk_live_...) here.
# STRIPE_SECRET_KEY=sk_test_...

# Private chapter files. Do not put them in this repository.
# Use an absolute directory outside the repo, or an https base URL.
# Files are named chapter-01.json through chapter-13.json.
# PRIVATE_CHAPTER_SOURCE=/absolute/path/outside/this/repo
# PRIVATE_CHAPTER_SOURCE=https://example.private.store/chapters
